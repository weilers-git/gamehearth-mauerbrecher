{
  "id": "mauerbrecher",
  "name": "Mauerbrecher",
  "version": "0.1.0",
  "description": "Mit dem Schläger einen Ball gegen eine Mauer aus Steinen schießen und sie in 10 Leveln zerschlagen",
  "repository": "https://github.com/weilers-git/gamehearth-mauerbrecher",
  "sdk": "^0.1.2",
  "license": {
    "code": "MIT",
    "assets": "CC0-1.0"
  },
  "mode": "single",
  "players": {
    "min": 1,
    "max": 1
  },
  "server": false,
  "client": "dist/client",
  "roles": {
    "player": {
      "inputs": [
        "touch",
        "keyboard"
      ],
      "screen": "small"
    }
  },
  "stats": {
    "punkte": {
      "label": "Punkte",
      "better": "higher",
      "format": "number"
    }
  }
}
